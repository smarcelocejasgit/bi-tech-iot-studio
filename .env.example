# Configuración local de Wi-Fi para Bi-Tech IoT Studio (V0.4A)
# Copiar a .env.local (excluido por .gitignore) cuando se disponga de la red física.
# NUNCA subir credenciales reales a Git.

BITECH_WIFI_SSID="SSID_PENDIENTE_CONFIGURACION"
BITECH_WIFI_PASS="PASS_PENDIENTE_CONFIGURACION"

# URL HTTPS pública del gateway local de Camera Node.
# Configurar el valor real únicamente en .env.production.local.
VITE_CAMERA_GATEWAY_URL="https://CAMERA_GATEWAY_PUBLIC_HOST"

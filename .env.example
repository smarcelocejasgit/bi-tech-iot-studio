# Ejemplo de configuración de entorno para Bi-Tech IoT Studio
# Copiar como .env.local y completar únicamente en el entorno local.
# NUNCA incluir credenciales reales en el repositorio.

# Configuración opcional para Camera Node (se define localmente cuando se verifique el firmware)
VITE_CAMERA_STREAM_URL=
VITE_DEFAULT_WIFI_SSID=

# Configuración futura para servicios (V0.5+)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
